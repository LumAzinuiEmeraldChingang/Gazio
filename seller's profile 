<!DOCTYPE html>
<html>
<head>
    <title>Seller Profile</title>
    <style>
        body {
            background-color: lightblue;   /* DO NOT CHANGE */
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        /* BACK BUTTON */
        .back {
            position: absolute;
            top: 15px;
            left: 15px;
            text-decoration: none;
            font-size: 20px;
            color: #1f4e79;
        }

        .back:hover {
            color: #0b2e4f;
        }

        /* MAIN CONTAINER */
        .container {
            width: 80%;
            max-width: 1000px;
            margin: 80px auto;
            background-color: white;
            padding: 20px;
            border-radius: 10px;
        }

        /* SELLER INFO */
        .seller-info {
            display: flex;
            align-items: center;
            border-bottom: 2px solid #4a90e2;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .seller-info img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 2px solid #4a90e2;
            margin-right: 20px;
        }

        .seller-info div {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .seller-info input {
            padding: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            width: 200px;
        }

        /* GAS BOTTLES GRID */
        h3 {
            color: #1f4e79;
            margin-bottom: 15px;
        }

        .bottles {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .card {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 15px;
            display: flex;
            flex-direction: row; /* image left, info right */
            align-items: center;
            justify-content: flex-start;
            gap: 15px;
        }

        .card img {
            width: 120px;   /* adjust image size */
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
        }

        .card-info {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex: 1;
        }

        .card-info input {
            width: 100%;
            padding: 4px;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .card-info p {
            margin: 2px 0;
            font-size: 14px;
        }

        .qty {
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: 5px;
        }

        .qty button {
            width: 28px;
            height: 28px;
            font-size: 18px;
            border: none;
            background-color: #4a90e2;
            color: white;
            border-radius: 4px;
            cursor: pointer;
        }

        .qty input {
            width: 40px;
            text-align: center;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .reserve {
            margin-top: 6px;
            background-color: green;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 5px;
            cursor: pointer;
            width: fit-content;
        }
    </style>
</head>
<body>

<a href="javascript:history.back()" class="back">⬅ </a>

<div class="container">
    <!-- SELLER INFO PLACEHOLDERS -->
    <div class="seller-info">
        <img src="placeholder.png" alt="Profile">
        <div>
            <input type="text" placeholder="Seller Name">
            <input type="text" placeholder="Location">
            <input type="text" placeholder="Contact">
        </div>
    </div>

    <h3>Available Gas Bottles</h3>

    <div class="bottles">

        <!-- GAS 1 -->
        <div class="card">
            <img src="placeholder.png" alt="Gas Bottle">
            <div class="card-info">
                <input type="text" placeholder="Gas Name">
                <p>Size: <input type="text" placeholder="--kg"></p>
                <p>Price: <input type="text" placeholder="-- FCFA"></p>
                <p>Stock: <input type="text" placeholder="--"></p>

                <div class="qty">
                    <button onclick="changeQty(this,-1)">−</button>
                    <input type="text" value="1" readonly>
                    <button onclick="changeQty(this,1)">+</button>
                </div>

                <button class="reserve">Reserve</button>
            </div>
        </div>

        <!-- GAS 2 -->
        <div class="card">
            <img src="placeholder.png" alt="Gas Bottle">
            <div class="card-info">
                <input type="text" placeholder="Gas Name">
                <p>Size: <input type="text" placeholder="--kg"></p>
                <p>Price: <input type="text" placeholder="-- FCFA"></p>
                <p>Stock: <input type="text" placeholder="--"></p>

                <div class="qty">
                    <button onclick="changeQty(this,-1)">−</button>
                    <input type="text" value="1" readonly>
                    <button onclick="changeQty(this,1)">+</button>
                </div>

                <button class="reserve">Reserve</button>
            </div>
        </div>

        <!-- GAS 3 -->
        <div class="card">
            <img src="placeholder.png" alt="Gas Bottle">
            <div class="card-info">
                <input type="text" placeholder="Gas Name">
                <p>Size: <input type="text" placeholder="--kg"></p>
                <p>Price: <input type="text" placeholder="-- FCFA"></p>
                <p>Stock: <input type="text" placeholder="--"></p>

                <div class="qty">
                    <button onclick="changeQty(this,-1)">−</button>
                    <input type="text" value="1" readonly>
                    <button onclick="changeQty(this,1)">+</button>
                </div>

                <button class="reserve">Reserve</button>
            </div>
        </div>

        <!-- GAS 4 -->
        <div class="card">
            <img src="placeholder.png" alt="Gas Bottle">
            <div class="card-info">
                <input type="text" placeholder="Gas Name">
                <p>Size: <input type="text" placeholder="--kg"></p>
                <p>Price: <input type="text" placeholder="-- FCFA"></p>
                <p>Stock: <input type="text" placeholder="--"></p>

                <div class="qty">
                    <button onclick="changeQty(this,-1)">−</button>
                    <input type="text" value="1" readonly>
                    <button onclick="changeQty(this,1)">+</button>
                </div>

                <button class="reserve">Reserve</button>
            </div>
        </div>

        <!-- GAS 5 -->
        <div class="card">
            <img src="placeholder.png" alt="Gas Bottle">
            <div class="card-info">
                <input type="text" placeholder="Gas Name">
                <p>Size: <input type="text" placeholder="--kg"></p>
                <p>Price: <input type="text" placeholder="-- FCFA"></p>
                <p>Stock: <input type="text" placeholder="--"></p>

                <div class="qty">
                    <button onclick="changeQty(this,-1)">−</button>
                    <input type="text" value="1" readonly>
                    <button onclick="changeQty(this,1)">+</button>
                </div>

                <button class="reserve">Reserve</button>
            </div>
        </div>

    </div>
</div>

<script>
function changeQty(btn, change) {
    let input = btn.parentElement.querySelector("input[type=text]");
    let value = parseInt(input.value) + change;
    if (value < 1 || isNaN(value)) value = 1;  // minimum 1
    input.value = value;
}
</script>

</body>
</html>
                   